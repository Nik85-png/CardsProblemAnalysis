# ---------------------------------------------------------------------------
# Power BI push-dataset configuration
# ---------------------------------------------------------------------------
# To enable the "Push current dataset to Power BI" button, create an Azure AD
# App Registration (service principal) and a Power BI push dataset, then fill
# in the values below. The service principal must be a Contributor or Admin in
# the target Power BI workspace, and "Allow service principals to use Power BI
# APIs" must be enabled in the Power BI admin portal.

POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_DATASET_ID=
POWERBI_TABLE_NAME=CardsDataset

# Secret required by the /api/powerbi/* endpoints. The same value must be
# entered in the UI before pushing or creating datasets.
POWERBI_PUSH_SECRET=

# Optional: change the embedded Power BI report URL to point to a report built
# on the push dataset above. If omitted, the default shipped report URL is used.
# POWERBI_REPORT_EMBED_URL=https://app.powerbi.com/reportEmbed?reportId=...
